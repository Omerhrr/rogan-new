# =============================================================================
# ROGAN LIVE — Environment Variables
# Copy this file to .env and fill in all required values (marked REQUIRED).
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=rogan
POSTGRES_PASSWORD=REQUIRED_change_me         # REQUIRED — strong random password
POSTGRES_DB=rogan_live

# -----------------------------------------------------------------------------
# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# -----------------------------------------------------------------------------
JWT_SECRET=REQUIRED_change_me                # REQUIRED — startup fails if unset

# -----------------------------------------------------------------------------
# Google OAuth (for "Sign in with Google")
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=                            # REQUIRED for Google login
GOOGLE_CLIENT_SECRET=                        # REQUIRED for Google login

# -----------------------------------------------------------------------------
# CORS — JSON array of allowed origins (must include your frontend domain)
# Example production value: ["https://roganlive.com","https://www.roganlive.com"]
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# -----------------------------------------------------------------------------
# Public URLs — set these to your real domain in production
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=https://api.roganlive.com
MEDIAMTX_PUBLIC_HLS_BASE=https://hls.roganlive.com
NEXT_PUBLIC_WS_URL=wss://api.roganlive.com

# -----------------------------------------------------------------------------
# Crypto / Wallet
# -----------------------------------------------------------------------------
PLATFORM_WALLET_ADDRESS=REQUIRED_change_me   # REQUIRED — your hot wallet address
ROGAN_CONTRACT_ADDRESS=0x6914D994d82Bf0cC9d64cF32978d81868Ac5f1a9
ROGAN_DEXSCREENER_PAIR=0x1b0fb286fd0f0b48e9af0a5b7bdd2fabda60a55a
BASE_RPC_URL=https://mainnet.base.org
ROGAN_PRICE_FALLBACK_USD=0.000001

# -----------------------------------------------------------------------------
# MediaMTX
# -----------------------------------------------------------------------------
MEDIAMTX_WEBHOOK_SECRET=REQUIRED_change_me   # REQUIRED — shared secret for webhook auth

# -----------------------------------------------------------------------------
# Stripe (disabled for now — activate when ready)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Debug (NEVER true in production)
# -----------------------------------------------------------------------------
DEBUG=false
